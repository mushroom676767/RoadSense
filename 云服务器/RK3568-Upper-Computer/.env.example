# Web service
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
# Keep browser APIs and Socket.IO same-origin when publishing through a tunnel.
CORS_ORIGINS=same-origin
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=86400

# Administrator can view data and control the RK3568 device.
# The existing administrator password is not overwritten on restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Visitor can view realtime data and events, but cannot control the device.
VISITOR_USERNAME=visitor
VISITOR_PASSWORD=replace-with-a-different-password
ALLOW_REGISTER=false

# RK3568 SSH connection (never sent by the browser)
SSH_HOST=192.168.137.216
SSH_PORT=22
SSH_USER=cat
SSH_PASSWORD=replace-with-board-password
SSH_CONNECT_TIMEOUT=10
SSH_STOP_TIMEOUT=5
SSH_RESTART_ATTEMPTS=3
SSH_RESTART_DELAY_SECONDS=2
RK_WORK_DIR=/home/cat/RK3568/final

# The URL must be reachable from the RK3568 board.
# Windows Internet Connection Sharing commonly uses 192.168.137.1.
PUBLISH_URL=http://192.168.137.1:5000
PUBLISH_TOKEN=replace-with-a-long-shared-secret
PUBLISH_FPS=30
PUBLISH_QUALITY=50
MAX_INGEST_BYTES=16777216
MAX_INGEST_JSON_BYTES=262144
STREAM_STALE_SECONDS=3

# Browser video: H.264/WebRTC by default, with automatic JPEG fallback.
VIDEO_TRANSPORT=webrtc
WEBRTC_VIDEO_FPS=30
WEBRTC_VIDEO_WIDTH=1920
WEBRTC_VIDEO_HEIGHT=1080
WEBRTC_VIDEO_BITRATE=4000000
WEBRTC_VIDEO_MAX_BITRATE=5000000
WEBRTC_VIDEO_ENCODER=h264_nvenc
WEBRTC_MAX_VIEWERS=12
WEBRTC_PEER_QUEUE_FRAMES=60
WEBRTC_PROVIDER=mediamtx
WEBRTC_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Configure TURN for restrictive/symmetric NAT. Keep credentials secret.
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_OFFER_TIMEOUT_SECONDS=6
# Keep the RTSP encoder alive across brief board/network frame gaps.
WEBRTC_SOURCE_GRACE_SECONDS=12
# Browser heartbeat expires abandoned WHEP sessions after this interval.
WEBRTC_SESSION_TIMEOUT_SECONDS=60

# Cloud MediaMTX/SFU. Use a dedicated SSH key; never commit credentials.
MEDIA_MTX_HOST=203.0.113.10
MEDIA_MTX_SSH_USER=root
MEDIA_MTX_SSH_BIN=ssh
MEDIA_MTX_SSH_KEY=runtime/mediamtx_ed25519
MEDIA_MTX_KNOWN_HOSTS=runtime/mediamtx_known_hosts
MEDIA_MTX_LOCAL_RTSP_PORT=18554
MEDIA_MTX_LOCAL_WHEP_PORT=18889
MEDIA_MTX_PUBLISH_USERNAME=replace-with-publisher-user
MEDIA_MTX_PUBLISH_PASSWORD=replace-with-publisher-password
MEDIA_MTX_READ_USERNAME=replace-with-viewer-user
MEDIA_MTX_READ_PASSWORD=replace-with-viewer-password
MEDIA_MTX_START_TIMEOUT_SECONDS=10
MEDIA_MTX_SSH_KEEPALIVE_SECONDS=5
MEDIA_MTX_SSH_KEEPALIVE_COUNT=3
SHARED_LOG_MAX_CHARS=80000

# Cloudflare Named Tunnel (public browsers only; RK publishing stays on Ethernet).
# Keep the token secret and configure the hostname service as http://127.0.0.1:5000.
CLOUDFLARED_BIN=
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
CLOUDFLARE_PUBLIC_URL=https://traffic.example.com

# Events
DATABASE_PATH=
EVENT_SNAPSHOT_DIR=
EVENT_RETENTION_DAYS=30
EVENT_MAX_COUNT=10000
EVENT_COOLDOWN_SECONDS=10
PLATE_STABLE_FRAMES=3

# Split cloud / Windows Agent deployment (render-deployment.py)
# Documentation addresses only; replace with your own deployment addresses.
PUBLIC_IP=203.0.113.10
PRIVATE_IP=10.0.0.10
ACME_EMAIL=admin@example.com
AGENT_ID=rk3568-primary
AGENT_TOKEN=replace-with-at-least-64-random-characters
AGENT_SERVER_HOST=0.0.0.0
AGENT_LISTEN_HOST=192.168.137.1
MEDIA_MTX_ADMIN_USERNAME=replace-with-admin-user
MEDIA_MTX_ADMIN_PASSWORD=replace-with-admin-password
MEDIA_MTX_SRT_PASSPHRASE=replace-with-10-to-79-random-characters
