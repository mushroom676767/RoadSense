DEPLOYMENT_ROLE=cloud
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
CORS_ORIGINS=same-origin
JWT_SECRET_KEY=__JWT_SECRET_KEY__
JWT_COOKIE_SECURE=true
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_PASSWORD=__ADMIN_PASSWORD__
VISITOR_USERNAME=__VISITOR_USERNAME__
VISITOR_PASSWORD=__VISITOR_PASSWORD__
ALLOW_REGISTER=false

DATABASE_PATH=/var/lib/rk3568-manager/manager.db
EVENT_SNAPSHOT_DIR=/var/lib/rk3568-manager/events
EVENT_RETENTION_DAYS=30
EVENT_MAX_COUNT=10000

AGENT_ID=__AGENT_ID__
AGENT_TOKEN=__AGENT_TOKEN__
AGENT_STALE_SECONDS=6

VIDEO_TRANSPORT=webrtc
WEBRTC_PROVIDER=mediamtx
WEBRTC_MAX_VIEWERS=12
WEBRTC_OFFER_TIMEOUT_SECONDS=6
WEBRTC_SESSION_TIMEOUT_SECONDS=60
WEBRTC_STUN_URLS=stun:__PUBLIC_IP__:3478
WEBRTC_TURN_URLS=turn:__PUBLIC_IP__:3478?transport=udp,turn:__PUBLIC_IP__:3478?transport=tcp,turns:__PUBLIC_IP__:5349?transport=tcp
WEBRTC_TURN_USERNAME=__TURN_USER__
WEBRTC_TURN_CREDENTIAL=__TURN_PASSWORD__

MEDIA_MTX_INGEST_TRANSPORT=srt
MEDIA_MTX_WHEP_BASE_URL=http://127.0.0.1:8889
MEDIA_MTX_REQUIRE_PUBLISHER_READY=false
MEDIA_MTX_READ_USERNAME=__READ_USER__
MEDIA_MTX_READ_PASSWORD=__READ_PASSWORD__
HLS_FALLBACK_BASE_URL=/media/hls
